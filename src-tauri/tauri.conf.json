{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "鑫源AI画图",
  "version": "../package.json",
  "identifier": "com.xinyuanai.huatu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "鑫源AI画图",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' https://fontsapi.zeoseven.com/442/main/ https://cdn.jsdelivr.net/npm/@lobehub/webfont-harmony-sans-sc@1.0.0/",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: blob: http: https:",
        "font-src": "'self' data: https://fontsapi.zeoseven.com/442/main/ https://cdn.jsdelivr.net/npm/@lobehub/webfont-harmony-sans-sc@1.0.0/",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: https://api.github.com",
        "worker-src": "'self' blob:",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCRTVDQ0ZFOUEyQTMyMjUKUldRbE1pcWEvc3psSzVoTk85N1VMQ0xzSDBPM2JIcVRFS0p5Yk5VZTFqRnNZQWJYTkxtSGQ1VnQK",
      "endpoints": ["https://github.com/YUANGEGE1234/xinyuan-ai-huatu/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["xinyuan-image"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "template": "windows/installer.nsi"
      }
    }
  }
}
